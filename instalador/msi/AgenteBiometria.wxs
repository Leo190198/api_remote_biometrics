<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador por maquina do Agente de Biometria.

  Faz as tres coisas que um servidor RDS precisa:

    1. instala o binario em Program Files (x86) - x86 porque a NBioBSP.dll so
       existe em 32 bits;
    2. registra o comparador como servico Windows, que roda em sessao 0 - a
       unica onde o driver ftsjail.sys da FabulaTech nao injeta o gancho que
       corrompe a comparacao (docs/diagnostico-verifymatch-rdp-2026-07-30.md);
    3. poe o agente no logon de TODOS os usuarios, via HKLM\...\Run, para cada
       sessao RDP ganhar o seu na bandeja.

  Nao ha nada a configurar depois: o servico gera o proprio segredo e o publica
  em ProgramData, e o agente de cada sessao le dali. Sem variavel de ambiente,
  portanto sem depender de logoff para a sessao enxergar a mudanca.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Agente de Biometria"
      Manufacturer="Sermed Saude"
      Version="$(var.Versao)"
      UpgradeCode="8f3c1a94-6d2e-4b7a-9c05-1e8b47d2f6a3"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <!-- Substitui a versao anterior antes de copiar a nova: com o servico e o
         exe em uso, instalar por cima sem parar o antigo daria arquivo travado. -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="Ja existe uma versao mais nova do Agente de Biometria nesta maquina." />

    <MediaTemplate EmbedCab="yes" />

    <Launch
        Condition="VersionNT64 OR VersionNT >= 603"
        Message="Este instalador exige Windows 8.1/2012 R2 ou mais novo." />

    <Icon Id="AppIcon" SourceFile="$(var.PastaFontes)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Origens que o agente ja aceita sem ninguem clicar em "Autorizar
         acesso" na bandeja. Sao lidas do ambiente da maquina no arranque de
         cada agente (origins.go), entao valem para todos os usuarios.

         Publicas e Secure="yes" porque precisam atravessar a elevacao numa
         instalacao por maquina: sem isso, o valor digitado no dialogo (ou
         passado na linha de comando) nao chega na parte elevada do install e
         a variavel sairia vazia. -->
    <Property Id="SISTEMA_URL" Secure="yes" />
    <Property Id="CORS_ORIGEM" Secure="yes" />

    <UIRef Id="UiAgente" />

    <Feature Id="Principal" Title="Agente de Biometria" Level="1">
      <ComponentGroupRef Id="Componentes" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="PASTAINSTALACAO" Name="AgenteBiometria" />
    </StandardDirectory>

    <!-- ProgramData: onde o servico publica porta e token. A ACL herdada daqui
         ja da leitura a Users e escrita so a SYSTEM e administradores, que e
         exatamente a divisao entre quem le e quem escreve. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PASTADADOS" Name="AgenteBiometria" />
    </StandardDirectory>

    <ComponentGroup Id="Componentes">

      <Component Id="CompAgente" Directory="PASTAINSTALACAO" Guid="*">
        <File Id="AgenteBiometriaExe"
              Source="$(var.PastaFontes)\AgenteBiometria.exe"
              KeyPath="yes" />

        <ServiceInstall
            Id="ServicoComparador"
            Name="AgenteBiometriaComparador"
            DisplayName="Agente de Biometria - Comparador"
            Description="Compara templates biometricos em sessao 0, fora do alcance do redirecionador de dispositivo que corrompe a comparacao dentro da sessao RDP."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
            Arguments="--comparador"
            Vital="yes">
          <!-- Reinicio automatico: o comparador atende todas as sessoes do
               servidor, entao ele parado significa biometria parada para todo
               mundo, e ninguem estaria olhando o services.msc na hora. -->
          <util:ServiceConfig
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="60"
              ResetPeriodInDays="1" />
        </ServiceInstall>

        <ServiceControl
            Id="ControleComparador"
            Name="AgenteBiometriaComparador"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>

      <!-- Componente de 32 bits, como o resto do pacote, entao a chave real
           gravada num Windows x64 e:
             HKLM\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Run
           E onde se deve procurar ao conferir a mao. O Windows 64 bits processa
           essa chave no logon junto com a nativa - e o caminho padrao de
           aplicacao 32 bits. Marcar o componente como 64 bits nao e opcao: o
           ICE80 recusa componente de 64 bits em pacote x86. -->
      <Component Id="CompLogon" Directory="PASTAINSTALACAO" Guid="*">
        <RegistryValue
            Root="HKLM"
            Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
            Name="AgenteBiometria"
            Type="string"
            Value="&quot;[PASTAINSTALACAO]AgenteBiometria.exe&quot;"
            KeyPath="yes" />
      </Component>

      <!-- O anuncio e criado em tempo de execucao, entao o MSI nao o conhece:
           sem esta limpeza explicita ele sobreviveria a desinstalacao, e um
           agente reinstalado depois tentaria falar com um servico que nao existe
           mais. -->
      <Component Id="CompDados" Directory="PASTADADOS" Guid="*">
        <CreateFolder />
        <RemoveFile Id="RemoveAnuncio" Name="comparador.json" On="uninstall" />
        <RemoveFile Id="RemoveLogComparador" Name="comparador.log" On="uninstall" />
        <RemoveFile Id="RemoveLogComparadorAntigo" Name="comparador.log.1" On="uninstall" />
        <!-- O certificado da maquina e a chave dele tambem nascem em tempo de
             execucao, criados pelo servico. O RemoveCertMaquina abaixo ja os
             apaga junto com o registro na loja Root; estas linhas cobrem o caso
             de a acao customizada ter falhado, para nao deixar chave privada
             para tras. -->
        <RemoveFile Id="RemoveCertPem" Name="cert.pem" On="uninstall" />
        <RemoveFile Id="RemoveKeyPem" Name="key.pem" On="uninstall" />
        <RemoveFolder Id="RemovePastaDados" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="SOFTWARE\Sermed\AgenteBiometria"
            Name="PastaDados"
            Type="string"
            Value="[PASTADADOS]"
            KeyPath="yes" />
      </Component>

      <!-- As origens pre-autorizadas, gravadas como variaveis de ambiente da
           MAQUINA: o agente de cada sessao le SISTEMA_URL e CORS_ORIGEM no
           arranque (origins.go), entao vale para todos os usuarios.

           Cada componente tem condicao: campo em branco no dialogo nao pode
           gravar variavel vazia. E o RegistryValue existe para ser o KeyPath -
           Environment nao serve de KeyPath - e de quebra deixa registrado o que
           foi configurado, para quem for diagnosticar depois nao ter que
           adivinhar de onde veio a autorizacao.

           Atencao operacional: variavel de maquina so e enxergada por sessao
           aberta DEPOIS da instalacao. Quem ja esta logado precisa sair e
           entrar para o agente dele receber a origem. -->
      <Component Id="CompSistemaUrl" Directory="PASTAINSTALACAO" Guid="*" Condition="SISTEMA_URL">
        <RegistryValue
            Root="HKLM"
            Key="SOFTWARE\Sermed\AgenteBiometria"
            Name="SistemaUrl"
            Type="string"
            Value="[SISTEMA_URL]"
            KeyPath="yes" />
        <Environment
            Id="EnvSistemaUrl"
            Name="SISTEMA_URL"
            Value="[SISTEMA_URL]"
            Action="set"
            System="yes"
            Part="all"
            Permanent="no" />
      </Component>

      <Component Id="CompCorsOrigem" Directory="PASTAINSTALACAO" Guid="*" Condition="CORS_ORIGEM">
        <RegistryValue
            Root="HKLM"
            Key="SOFTWARE\Sermed\AgenteBiometria"
            Name="CorsOrigem"
            Type="string"
            Value="[CORS_ORIGEM]"
            KeyPath="yes" />
        <Environment
            Id="EnvCorsOrigem"
            Name="CORS_ORIGEM"
            Value="[CORS_ORIGEM]"
            Action="set"
            System="yes"
            Part="all"
            Permanent="no" />
      </Component>

    </ComponentGroup>

    <!-- Tira da loja Root da maquina o certificado que o servico registrou.
         Sem isto, desinstalar o agente deixaria para tras uma raiz confiavel
         que ninguem sabe de onde veio - e o proprio exe e quem sabe qual
         registro apagar, porque ele guarda o certificado em disco e calcula o
         thumbprint a partir dele.

         Return="ignore" de proposito: um certutil que falhe nao pode impedir a
         desinstalacao. O RemoveFile do CompDados ainda leva a chave privada
         embora, que e a parte que realmente nao pode ficar. -->
    <CustomAction
        Id="PreparaRemocaoCertMaquina"
        Property="RemoveCertMaquina"
        Value="&quot;[#AgenteBiometriaExe]&quot; --remover-cert-maquina"
        Execute="immediate" />

    <CustomAction
        Id="RemoveCertMaquina"
        BinaryRef="Wix4UtilCA_X86"
        DllEntry="Wix4QuietExec_X86"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <!-- Antes do RemoveFiles porque a acao roda o proprio exe: depois dele o
           binario ja nao existe mais. -->
      <Custom Action="PreparaRemocaoCertMaquina" Before="RemoveCertMaquina" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RemoveCertMaquina" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
